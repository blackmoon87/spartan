APP_NAME="PHP MVC Boilerplate"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mvc_skills
DB_USERNAME=root
DB_PASSWORD=

RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW=60

# Proxies allowed to set X-Forwarded-For / Client-IP (comma separated).
# Leave EMPTY when the app is reachable directly — otherwise any client can
# forge its IP and bypass rate limiting. Accepts IPs, CIDR ranges, or '*'.
# TRUSTED_PROXIES=10.0.0.0/8,172.16.0.5
TRUSTED_PROXIES=

UPLOAD_PATH=

VIEW_CACHE_ENABLED=false
ROUTE_CACHE_ENABLED=false

